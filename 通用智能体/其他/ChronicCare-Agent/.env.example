# Unified ChronicCare runtime
CHRONICCARE_ENV=docker
CHRONICCARE_TOOL_SERVER_PORT=18088
CHRONICCARE_MCP_PORT=18188
CHRONICCARE_STREAMLIT_PORT=18501
CHRONICCARE_TOOL_SERVER_URL=http://127.0.0.1:18088
CHRONICCARE_DEPLOY_ROOT=.

# Runtime artifacts and optional model mounts
CHRONICCARE_TRACE_DIR=/app/outputs/mcp_traces
CHRONICCARE_MODEL_DIR=./models/MedCleanStd/bge-small-zh-v1.5
CHRONICCARE_CANN_ROOT=

# Optional Open SQL LLM candidate generation; leave disabled for offline/template mode
OPEN_SQL_LLM_ENABLED=false
OPEN_SQL_FORCE_LLM=false
OPEN_SQL_LLM_MODEL=deepseek-chat
OPEN_SQL_PROXY_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
