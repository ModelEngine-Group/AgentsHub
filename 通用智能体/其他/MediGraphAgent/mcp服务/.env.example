# ====== MediGraph-Agent configuration ======
# Copy this file to ".env" and fill in your keys, then: the code auto-loads it.

# ---- LLM provider selection ----
# Which provider to use by default: siliconflow | dashscope | deepseek
LLM_PROVIDER=siliconflow

# SiliconFlow (default). Get a key at https://siliconflow.cn
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-35B-A3B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Aliyun DashScope (fallback / alternative). https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# DeepSeek official API (another fallback / alternative). https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- LLM call tuning ----
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_TIMEOUT=120
LLM_ENABLE_THINKING=false   # Qwen3 thinking mode; off=faster, on=better planning/NL2SQL

# ---- Confidence-routed extraction ----
# auto: neural L1 first, then lexicon/LLM fallback; neural: force GPLinker; fast: offline lexicon only; llm: legacy API only
EXTRACTION_BACKEND=auto
EXTRACTION_LLM_FALLBACK=true
EXTRACTION_ROUTE_THRESHOLD=0.55
# NEURAL_EXTRACTOR_DIR=data/models/neural_extractor
# NEURAL_EXTRACTOR_THRESHOLD=0.0
# NEURAL_EXTRACTOR_REL_THRESHOLD=0.0
# FAST_EXTRACTOR_ARTIFACT=data/models/fast_extractor.json
# ENTITY_LINKER_ARTIFACT=data/models/entity_linker.json
# CALIBRATION_ARTIFACT=data/models/temperature_calibration.json

# ---- Analytics backend (Task 3 relational layer) ----
# sqlite   -> file DB under outputs/ (zero-config default; CI and demos use this)
# postgres -> pooled PostgreSQL with real indexes; needs the container below:
#   docker run -d --name medigraph-pg -e POSTGRES_PASSWORD=... -e POSTGRES_DB=medigraph \
#     -p 5433:5432 -v medigraph-pg-data:/var/lib/postgresql/data pgvector/pgvector:pg16
# (host port 5433 because 5432/5434 are taken by the DataMate/Nexent stacks)
ANALYTICS_BACKEND=sqlite
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medigraph
PG_POOL_MIN=1
PG_POOL_MAX=8

# ---- Redis result cache (extraction / NL2SQL responses) ----
# docker run -d --name medigraph-redis -p 6380:6379 redis:7-alpine redis-server --appendonly yes
# (host port 6380 because 6379 is taken by the Nexent stack's Redis)
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_TTL_SECONDS=3600

# ---- Knowledge-graph backend ----
# local  -> NetworkX + JSON (zero dependency, runs now)
# neo4j  -> use a running Neo4j instance (set NEO4J_* below)
GRAPH_BACKEND=local

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-password

# ---- Docker / platform integration ----
# compose.yaml maps the project services to host ports 8011 and 8100.
MEDIGRAPH_MCP_PORT=8011
MEDIGRAPH_A2A_PORT=8100
MEDIGRAPH_A2A_PUBLIC_URL=http://host.docker.internal:8100
DATAMATE_DOCKER_BASE=http://host.docker.internal:8080/api
FINETUNED_ORCHESTRATOR_DOCKER_URL=http://host.docker.internal:18088/v1/chat/completions
# false = compact deterministic/LLM-fallback image; true = also install torch/transformers.
MEDIGRAPH_INSTALL_NEURAL=false
