# Copy required values into your shell environment or a local .env file.
# Never commit real API keys or authentication tokens.

# Optional OpenAI-compatible model endpoint. The offline rule-based demo does
# not require an LLM.
OPENAI_API_BASE=http://127.0.0.1:8000/v1
OPENAI_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-model-name
EMBEDDING_MODEL=replace-with-your-embedding-model

# Local DataMate and Nexent source directories.
DATAMATE_HOME=/absolute/path/to/DataMate
NEXENT_HOME=/absolute/path/to/nexent

# Host-side service endpoints. Adjust these for your deployment.
DATAMATE_URL=http://localhost:30000
DATAMATE_API_BASE=http://localhost:8080
DATAMATE_RUNTIME_API=http://localhost:18000
DATAMATE_KNOWLEDGE_BASE_ID=replace-after-importing-knowledge-base

NEXENT_URL=http://localhost:3000
NEXENT_CONFIG_API=http://localhost:5010
NEXENT_RUNTIME_API=http://localhost:5014
NEXENT_MCP_MANAGEMENT_API=http://localhost:5015
NEXENT_AUTH_TOKEN=

# Address used by a Docker-based Nexent instance to call the host demo API.
MODELENGINE_DEMO_API_URL=http://localhost:8088
MODELENGINE_DEMO_API_NEXENT_URL=http://host.docker.internal:8088

# Optional tensor/NPU and LLM enhancements. CPU/rule mode is the portable
# baseline and works without these settings.
ENABLE_NPU=false
MEDICAL_DEMO_USE_LLM=false
MEDICAL_KG_BACKEND=rule
TASK3_ANALYSIS_ENABLE_TENSOR=false
