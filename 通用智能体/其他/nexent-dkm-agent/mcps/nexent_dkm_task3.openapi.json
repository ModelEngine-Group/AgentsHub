  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://host.docker.internal:8003"
    }
  ],
  "components": {
    "schemas": {
      "SqlRequest": {
        "type": "object",
        "title": "SqlRequest",
        "required": [
          "task_id"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "question": {
            "type": "string",
            "title": "Question",
            "default": "哪些疾病关联最多症状？"
          }
        }
      },
      "PathRequest": {
        "type": "object",
        "title": "PathRequest",
        "required": [
          "task_id",
          "start_entity"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "max_depth": {
            "type": "integer",
            "title": "Max Depth",
            "default": 4,
            "maximum": 10.0,
            "minimum": 1.0
          },
          "end_entity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Entity"
          },
          "start_entity": {
            "type": "string",
            "title": "Start Entity"
          }
        }
      },
      "TaskResponse": {
        "type": "object",
        "title": "TaskResponse",
        "required": [
          "task_id",
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          }
        }
      },
      "Nl2SqlRequest": {
        "type": "object",
        "title": "Nl2SqlRequest",
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "default": "哪些疾病关联最多症状？"
          },
          "graph_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Graph File"
          }
        }
      },
      "ProcessRequest": {
        "type": "object",
        "title": "ProcessRequest",
        "properties": {
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "graph_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Graph File"
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Dir"
          },
          "task_request": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Request"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "properties": {
          "ctx": {
            "type": "object",
            "title": "Context"
          },
          "loc": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail"
          }
        }
      }
    }
  }
}