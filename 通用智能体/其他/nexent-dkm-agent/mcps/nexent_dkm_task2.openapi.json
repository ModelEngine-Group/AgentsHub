  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://host.docker.internal:8002"
    }
  ],
  "components": {
    "schemas": {
      "QueryRequest": {
        "type": "object",
        "title": "QueryRequest",
        "required": [
          "task_id",
          "entity"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 20,
            "maximum": 100.0,
            "minimum": 1.0
          },
          "entity": {
            "type": "string",
            "title": "Entity"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "relation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relation"
          },
          "direction": {
            "type": "string",
            "title": "Direction",
            "default": "out",
            "pattern": "^(out|in|both)$"
          }
        }
      },
      "TaskResponse": {
        "type": "object",
        "title": "TaskResponse",
        "required": [
          "task_id",
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          }
        }
      },
      "ProcessRequest": {
        "type": "object",
        "title": "ProcessRequest",
        "properties": {
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "input_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Path"
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Dir"
          },
          "task_request": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Request"
          },
          "llm_config_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Config Path"
          },
          "local_model_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Model Path"
          }
        }
      },
      "MultiHopRequest": {
        "type": "object",
        "title": "MultiHopRequest",
        "required": [
          "task_id",
          "start_entity"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "max_hops": {
            "type": "integer",
            "title": "Max Hops",
            "default": 3,
            "maximum": 5.0,
            "minimum": 1.0
          },
          "max_paths": {
            "type": "integer",
            "title": "Max Paths",
            "default": 5,
            "maximum": 20.0,
            "minimum": 1.0
          },
          "start_entity": {
            "type": "string",
            "title": "Start Entity"
          },
          "target_entity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Entity"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "properties": {
          "ctx": {
            "type": "object",
            "title": "Context"
          },
          "loc": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          }
        }
      },
      "EvidenceQARequest": {
        "type": "object",
        "title": "EvidenceQARequest",
        "required": [
          "task_id",
          "question"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "max_hops": {
            "type": "integer",
            "title": "Max Hops",
            "default": 2,
            "maximum": 4.0,
            "minimum": 1.0
          },
          "question": {
            "type": "string",
            "title": "Question"
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail"
          }
        }
      }
    }
  }
}