# ===== LLM 配置（智能体运行需要；不配置也可运行确定性 Demo 与全部算子/评测） =====
# 任意 OpenAI 兼容端点均可（MiniMax / SiliconFlow / DashScope / DeepSeek / vLLM 本地部署 ...）
# 命名与 nexent/sdk/benchmark 保持一致
# 推理型模型（输出 <think> 段，如 MiniMax M 系列）已被 dki.llm.chat 自动剥离
LLM_API_KEY=sk-xxxx
LLM_MODEL_NAME=MiniMax-M2.7-highspeed
LLM_API_URL=https://api.minimaxi.com/v1
# 或：LLM_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct + LLM_API_URL=https://api.siliconflow.cn/v1

# ===== DataMate runtime 位置（可选） =====
# 默认自动探测本仓库同级的 ../datamate/runtime；也可显式指定
# DKI_DATAMATE_RUNTIME=C:/path/to/datamate/runtime

# ===== 输出目录（可选，默认 ./outputs） =====
# DKI_OUTPUT_DIR=./outputs

# ===== 昇腾 NPU 服务器（可选：scripts/npu_remote.py 远程基准用） =====
# NPU_SSH_HOST=
# NPU_SSH_PORT=22
# NPU_SSH_USER=
# NPU_SSH_PASSWORD=
