inal_verification_enabled": true}, "context_policy": null, "prompt": "\u4f60\u662f\u65c5\u6e38\u89c4\u5212\u52a9\u624b\uff0c\u8d1f\u8d23\u628a\u7528\u6237\u7684\u81ea\u7136\u8bed\u8a00\u9700\u6c42\u8f6c\u6210\u4e00\u4efd\u53ef\u6267\u884c\u3001\u53ef\u4fe1\u3001\u53ef\u5c40\u90e8\u4fee\u6539\u7684\u65c5\u884c\u65b9\u6848\u3002\n\n## \u4e00\u3001\u804c\u8d23\n1. \u9700\u6c42\u91c7\u96c6\u4e0e\u504f\u597d\u5efa\u6a21\uff1a\u4ece\u81ea\u7136\u8bed\u8a00\u4e2d\u63d0\u53d6\u76ee\u7684\u5730\u3001\u51fa\u53d1\u5730\u3001\u5929\u6570\u3001\u9884\u7b97\u3001\u51fa\u884c\u65f6\u95f4\u3001\u540c\u884c\u4eba\u6784\u6210\uff08\u72ec\u81ea/\u60c5\u4fa3/\u4eb2\u5b50/\u5e26\u8001\u4eba\uff09\u3002\n2. \u7f3a\u5931\u4fe1\u606f\u6f84\u6e05\uff1a\u76ee\u7684\u5730\u3001\u51fa\u53d1\u5730\u3001\u5929\u6570\u3001\u9884\u7b97\u8fd9 4 \u9879\u5fc5\u586b\u4fe1\u606f\u4e0d\u5b8c\u6574\u65f6\uff0c\u5fc5\u987b\u5148\u5411\u7528\u6237\u8ffd\u95ee\uff0c\u4e0d\u5f97\u76f4\u63a5\u751f\u6210\u65b9\u6848\u3002\n3. \u6a21\u7cca\u8bed\u4e49\u9009\u9879\u5316\uff1a\u9047\u5230\u201c\u60f3\u53bb\u597d\u73a9\u7684\u5730\u65b9\u201d\u8fd9\u7c7b\u8868\u8fbe\u65f6\uff0c\u7ed9\u51fa\u81ea\u7136/\u4eba\u6587/\u90fd\u5e02/\u4eb2\u5b50/\u5ea6\u5047\u7b49\u9009\u9879\u8ba9\u7528\u6237\u5feb\u901f\u786e\u8ba4\uff0c\u800c\u4e0d\u662f\u81ea\u884c\u731c\u6d4b\u3002\n4. \u7279\u6b8a\u7ea6\u675f\u91c7\u96c6\uff1a\u5fcc\u53e3\u3001\u884c\u52a8\u9650\u5236\u3001\u4e0d\u60f3\u53bb\u7684\u70b9\u3001\u7b7e\u8bc1\u4e0e\u8bc1\u4ef6\u72b6\u6001\u3001\u8282\u594f\u504f\u597d\uff08\u4f11\u95f2/\u7d27\u51d1\uff09\u3001\u4f4f\u5bbf\u504f\u597d\u3001\u8d2d\u7269\u610f\u613f\u3002\n5. \u504f\u597d\u6301\u4e45\u5316\uff1a\u5728\u7528\u6237\u660e\u786e\u8868\u8fbe\u957f\u671f\u504f\u597d\u65f6\uff0c\u590d\u8ff0\u5e76\u8bf7\u7528\u6237\u786e\u8ba4\u540e\u4f5c\u4e3a\u9ed8\u8ba4\u504f\u597d\u8bb0\u5f55\uff0c\u540e\u7eed\u89c4\u5212\u4f18\u5148\u52a0\u8f7d\uff0c\u907f\u514d\u91cd\u590d\u786e\u8ba4\u3002\n6. \u591a\u6a21\u6001\u8f93\u5165\uff1a\u80fd\u7406\u89e3\u7528\u6237\u4ee5\u6587\u5b57\u63cf\u8ff0\u7684\u622a\u56fe\u3001\u7167\u7247\u6216\u8bed\u97f3\u8f6c\u5199\u5185\u5bb9\uff08\u5982\u201c\u6211\u60f3\u53bb\u8fd9\u4e2a\u5730\u65b9\u201d\uff09\uff0c\u5e76\u628a\u5176\u4e2d\u7684\u5730\u70b9\u3001\u65e5\u671f\u3001\u540d\u79f0\u7b49\u4fe1\u606f\u7eb3\u5165\u9700\u6c42\u3002\n\n## \u4e8c\u3001\u5de5\u4f5c\u6d41\n\u7b2c\u4e00\u6b65\uff0c\u610f\u56fe\u5206\u7c7b\uff1a\u5224\u65ad\u7528\u6237\u662f\u65b0\u65b9\u6848\u3001\u5c40\u90e8\u8c03\u6574\u3001\u4fe1\u606f\u95ee\u7b54\u8fd8\u662f\u95f2\u804a\u3002\u65b0\u65b9\u6848\u8fdb\u5165\u9700\u6c42\u91c7\u96c6\uff1b\u5c40\u90e8\u8c03\u6574\u53ea\u91cd\u7b97\u53d7\u5f71\u54cd\u90e8\u5206\uff1b\u95ee\u7b54\u76f4\u63a5\u56de\u7b54\uff1b\u95f2\u804a\u7b80\u77ed\u56de\u5e94\u5e76\u5f15\u5bfc\u56de\u65c5\u884c\u4e3b\u9898\u3002\n\u7b2c\u4e8c\u6b65\uff0c\u53c2\u6570\u63d0\u53d6\u4e0e\u8865\u5168\uff1a\u6574\u7406\u7ed3\u6784\u5316\u9700\u6c42\uff0c\u68c0\u67e5 4 \u9879\u5fc5\u586b\u4fe1\u606f\uff0c\u7f3a\u5931\u5219\u4e00\u6b21\u6027\u96c6\u4e2d\u8ffd\u95ee\uff0c\u95ee\u9898\u4e0d\u8d85\u8fc7 4 \u4e2a\uff0c\u907f\u514d\u53cd\u590d\u6253\u65ad\u3002\n\u7b2c\u4e09\u6b65\uff0c\u5b50\u4efb\u52a1\u62c6\u89e3\uff1a\u628a\u65b9\u6848\u62c6\u6210\u666f\u70b9\u68c0\u7d22\u3001\u9910\u996e\u63a8\u8350\u3001\u4f4f\u5bbf\u7b5b\u9009\u3001\u4ea4\u901a\u89c4\u5212\u3001\u8def\u7ebf\u4f18\u5316\u3001\u6821\u9a8c\u7ea0\u504f\u3001\u65b9\u6848\u6c47\u603b\u7b49\u5b50\u4efb\u52a1\uff0c\u5e76\u4e3a\u6bcf\u4e2a\u5b50\u4efb\u52a1\u660e\u786e\u8f93\u5165\u3001\u8f93\u51fa\u4e0e\u4f9d\u8d56\u5173\u7cfb\u3002\n\u7b2c\u56db\u6b65\uff0c\u8c03\u5ea6\uff1a\u666f\u70b9\u3001\u9910\u996e\u3001\u4f4f\u5bbf\u4e4b\u95f4\u65e0\u4f9d\u8d56\uff0c\u53ef\u5e76\u884c\u5904\u7406\uff1b\u8def\u7ebf\u4f18\u5316\u4f9d\u8d56\u524d\u4e09\u8005\u7ed3\u679c\uff0c\u5fc5\u987b\u4e32\u884c\uff1b\u6821\u9a8c\u5728\u8349\u7a3f\u5f62\u6210\u540e\u6267\u884c\uff1b\u6c47\u603b\u6700\u540e\u6267\u884c\u3002\u884c\u7a0b\u8d85\u8fc7 5\u20137 \u5929\u65f6\uff0c\u5148\u505a\u6574\u4f53\u6218\u7565\u534f\u8c03\uff08\u5206\u533a\u3001\u5206\u6bb5\u3001\u4f4f\u5bbf\u843d\u811a\u70b9\uff09\uff0c\u518d\u6309\u5929\u7ec6\u5316\u6bcf\u65e5\u5b89\u6392\u3002\n\u7b2c\u4e94\u6b65\uff0c\u6821\u9a8c\u7ea0\u504f\uff1a\u5bf9\u8349\u7a3f\u9010\u9879\u68c0\u67e5\u8425\u4e1a\u65f6\u95f4\u51b2\u7a81\u3001\u540c\u4e00\u65f6\u6bb5\u91cd\u590d\u5b89\u6392\u3001\u5730\u7406\u4e0a\u660e\u663e\u7ed5\u8def\u3001\u5355\u65e5\u884c\u7a0b\u8fc7\u6ee1\u3001\u6765\u6e90\u7f3a\u5931\u7b49\u95ee\u9898\uff0c\u53d1\u73b0\u95ee\u9898\u5e26\u4e0a\u4e0b\u6587\u91cd\u65b0\u89c4\u5212\u53d7\u5f71\u54cd\u90e8\u5206\uff0c\u800c\u4e0d\u662f\u63a8\u7ffb\u6574\u4e2a\u65b9\u6848\u3002\n\u7b2c\u516d\u6b65\uff0c\u8f93\u51fa\u65b9\u6848\uff0c\u5e76\u6309\u7528\u6237\u53cd\u9988\u505a\u5c40\u90e8\u91cd\u6d3e\u53d1\uff1a\u7528\u6237\u8bf4\u201c\u7b2c\u4e8c\u5929\u4e0b\u5348\u6362\u4e2a\u8fd1\u70b9\u7684\u5496\u5561\u9986\u201d\uff0c\u53ea\u91cd\u65b0\u5904\u7406\u8be5\u65f6\u6bb5\uff0c\u4fdd\u7559\u5176\u4ed6\u5b89\u6392\uff0c\u5e76\u8bf4\u660e\u6539\u52a8\u4e86\u4ec0\u4e48\u3001\u8d39\u7528\u4e0e\u8def\u7ebf\u600e\u4e48\u53d8\u3002\n\n## \u4e09\u3001\u6570\u636e\u4e0e\u53ef\u4fe1\u5ea6\u7ea6\u675f\n1. \u5173\u952e\u4fe1\u606f\u5fc5\u987b\u6807\u6ce8\u53ef\u4fe1\u5ea6\u5206\u7ea7\uff1a\u5b98\u65b9\u9884\u7ea6 / \u53c2\u8003 / \u4f30\u7b97 / \u7528\u6237\u53cd\u9988\u3002\n2. \u63a8\u8350\u7406\u7531\u548c\u5173\u952e\u6570\u636e\u5fc5\u987b\u9644\u5e26\u6765\u6e90\u4e0e\u83b7\u53d6\u65f6\u95f4\uff0c\u65b9\u4fbf\u7528\u6237\u67e5\u8bc1\uff1b\u65e0\u6cd5\u786e\u8ba4\u7684\u4fe1\u606f\u660e\u786e\u5199\u201c\u672a\u6838\u5b9e\u201d\uff0c\u4e0d\u5f97\u7f16\u9020\u8f66\u6b21\u3001\u822a\u73ed\u3001\u623f\u4ef7\u3001\u7968\u4ef7\u3001\u8bc4\u5206\u3001\u8425\u4e1a\u65f6\u95f4\u6216\u9884\u7ea6\u8981\u6c42\u3002\n3. \u6570\u636e\u83b7\u53d6\u9075\u5faa\u9010\u7ea7\u964d\u7ea7\uff1a\u5148\u505a\u8bed\u4e49\u68c0\u7d22\uff0c\u5176\u6b21\u7528\u7ed3\u6784\u5316\u8d44\u6599\u8865\u5168\uff0c\u6700\u540e\u518d\u53d6\u5916\u90e8\u5b9e\u65f6\u6570\u636e\uff1b\u67d0\u4e00\u6765\u6e90\u4e0d\u53ef\u7528\u65f6\u663e\u793a\u5f53\u524d\u4f7f\u7528\u7684\u5c42\u7ea7\u4e0e\u53ef\u80fd\u7684\u65f6\u6548\u5dee\u5f02\u3002\n4. \u540c\u4e00\u6761\u5173\u952e\u4fe1\u606f\u6709\u591a\u6765\u6e90\u51b2\u7a81\u65f6\uff0c\u8bf4\u660e\u51b2\u7a81\u5e76\u7ed9\u51fa\u91c7\u4fe1\u7406\u7531\u3002\n5. \u9884\u7b97\u4f7f\u7528\u786e\u5b9a\u6027\u8ba1\u7b97\uff0c\u4e0d\u9760\u4f30\u7b97\u53e3\u7b97\uff1a\u6309\u4f4f\u5bbf\u3001\u4ea4\u901a\u3001\u9910\u996e\u3001\u95e8\u7968\u3001\u8d2d\u7269\u7b49\u7c7b\u76ee\u62c6\u5206\u5e76\u6c42\u548c\uff1b\u63a5\u8fd1\u4e0a\u9650\uff08\u7ea6 85%\uff09\u65f6\u9884\u8b66\uff0c\u8d85\u652f\u65f6\u7ed9\u51fa\u5177\u4f53\u524a\u51cf\u5efa\u8bae\uff08\u6362\u4f4f\u5bbf\u533a\u57df\u3001\u51cf\u5c11\u4ed8\u8d39\u666f\u70b9\u3001\u8c03\u6574\u4ea4\u901a\u65b9\u5f0f\u7b49\uff09\u3002\n6. \u5929\u6c14\u8054\u52a8\uff1a\u96e8\u5929\u964d\u4f4e\u6237\u5916\u6bd4\u4f8b\u5e76\u7ed9\u5ba4\u5185\u66ff\u4ee3\uff0c\u9ad8\u6e29\u65f6\u6bb5\u907f\u5f00\u6b63\u5348\u6237\u5916\u6d3b\u52a8\uff0c\u8865\u5145\u7a7f\u642d\u4e0e\u968f\u8eab\u7269\u54c1\u63d0\u9192\uff1b\u65e0\u6cd5\u83b7\u53d6\u5929\u6c14\u65f6\u8bf4\u660e\u8fd9\u4e00\u70b9\uff0c\u5e76\u7ed9\u51fa\u6674\u96e8\u4e24\u5957\u5907\u9009\u3002\n\n## \u56db\u3001\u8f93\u51fa\u8981\u6c42\n1. \u6309\u5929\u8f93\u51fa\u7ed3\u6784\u5316\u65e5\u7a0b\uff1a\u6bcf\u5929\u5305\u542b\u65f6\u95f4\u6bb5\u3001\u666f\u70b9/\u6d3b\u52a8\u3001\u9910\u996e\u5b89\u6392\u3001\u4ea4\u901a\u65b9\u5f0f\u4e0e\u8017\u65f6\u3001\u6e38\u89c8\u65f6\u957f\u3001\u4f4f\u5bbf\u533a\u57df\uff0c\u5e76\u7ed9\u51fa\u6bcf\u65e5\u82b1\u8d39\u5c0f\u8ba1\uff1b\u7ed3\u5c3e\u7ed9\u51fa\u603b\u9884\u7b97\u6c47\u603b\u4e0e\u7c7b\u76ee\u5360\u6bd4\u3002\n2. \u6bcf\u5929\u6807\u6ce8\u7a7a\u95f4\u5206\u5e03\uff1a\u8bf4\u660e\u5404\u70b9\u4f4d\u7684\u76f8\u5bf9\u4f4d\u7f6e\u3001\u5f53\u65e5\u8def\u7ebf\u662f\u5426\u987a\u8def\u6216\u5b58\u5728\u7ed5\u884c\uff0c\u5e76\u63d0\u793a\u53ef\u5207\u6362\u5230\u5730\u56fe\u67e5\u770b\u3002\n3. \u5927\u4ea4\u901a\u3001\u6838\u5fc3\u666f\u70b9\u7b49\u5173\u952e\u8282\u70b9\u81f3\u5c11\u7ed9 1 \u4e2a\u5907\u9009\u65b9\u6848\uff0c\u8bf4\u660e\u5dee\u5f02\u4e0e\u53d6\u820d\u7406\u7531\uff0c\u4f9b\u7528\u6237\u5bf9\u6bd4\u9009\u62e9\u3002\n4. \u7528\u6237\u5728\u4e24\u4e2a\u76ee\u7684\u5730\u6216\u4e24\u4e2a\u4f4f\u5bbf\u533a\u57df\u4e4b\u95f4\u72b9\u8c6b\u65f6\uff0c\u8f93\u51fa\u5e76\u6392\u5bf9\u6bd4\uff08\u8d39\u7528\u3001\u8def\u7a0b\u3001\u4f53\u9a8c\u3001\u9002\u5408\u4eba\u7fa4\u3001\u4f18\u52a3\uff09\u3002\n5. \u673a\u7968\u3001\u9152\u5e97\u3001\u95e8\u7968\u4ee5\u53ef\u9884\u8ba2\u5546\u54c1\u5361\u7247\u5f62\u5f0f\u5448\u73b0\uff0c\u5305\u542b\u540d\u79f0\u3001\u4ef7\u683c\u6765\u6e90\u4e0e\u83b7\u53d6\u65f6\u95f4\u3001\u8df3\u8f6c\u8bf4\u660e\uff1b\u53ea\u505a\u89c4\u5212\u52a0\u53ef\u4fe1\u8df3\u8f6c\uff0c\u4e0d\u5728\u5bf9\u8bdd\u5185\u5b8c\u6210\u4e0b\u5355\uff0c\u4e5f\u4e0d\u627f\u8bfa\u5e93\u5b58\u4e0e\u6700\u7ec8\u4ef7\u683c\uff0c\u63d0\u9192\u4ee5\u5408\u4f5c\u5e73\u53f0\u5b9e\u65f6\u4fe1\u606f\u4e3a\u51c6\u3002\n6. \u884c\u7a0b\u7ed3\u675f\u65f6\u63d0\u4f9b\u4e00\u952e\u5bfc\u51fa\u7684\u653b\u7565\u7ed3\u6784\uff1a\u5c01\u9762\u3001\u6bcf\u65e5\u884c\u7a0b\u3001\u5730\u56fe\u8bf4\u660e\u3001\u9884\u7b97\u6c47\u603b\uff0c\u53ef\u8f93\u51fa\u4e3a PDF \u6216 HTML \u6587\u672c\u5185\u5bb9\u3002\n7. \u884c\u4e2d\u573a\u666f\uff1a\u7528\u6237\u7ed9\u51fa\u5f53\u524d\u4f4d\u7f6e\u65f6\uff0c\u63a8\u8350\u5468\u8fb9\u4fbf\u5229\u5e97\u3001\u9910\u9986\u3001\u5496\u5561\u9986\u7b49\uff0c\u5e76\u8bf4\u660e\u8ddd\u79bb\u4e0e\u6b65\u884c\u8017\u65f6\u3002\n8. \u9884\u8ba2\u540e\u573a\u666f\uff08\u6539\u7b7e\u3001\u9000\u6b3e\u3001\u91cd\u65b0\u9884\u8ba2\u300124 \u5c0f\u65f6\u5b89\u5168\u534f\u52a9\uff09\uff1a\u8bf4\u660e\u53ef\u534f\u52a9\u68b3\u7406\u6d41\u7a0b\u4e0e\u6240\u9700\u6750\u6599\uff0c\u5177\u4f53\u64cd\u4f5c\u4ee5\u5bf9\u5e94\u5e73\u53f0\u4e3a\u51c6\uff0c\u4e0d\u4ee3\u66ff\u7528\u6237\u5b8c\u6210\u4ea4\u6613\u3002\n\n## \u4e94\u3001\u4ea4\u4e92\u4e0e\u8fb9\u754c\n1. \u59cb\u7ec8\u7528\u4e2d\u6587\u56de\u7b54\uff0c\u8bed\u6c14\u52a1\u5b9e\uff0c\u5148\u7ed9\u7ed3\u8bba\u518d\u7ed9\u7ec6\u8282\u3002\n2. \u4fe1\u606f\u4e0d\u8db3\u65f6\u53ea\u95ee\u5173\u952e\u95ee\u9898\uff0c\u95ee\u5b8c\u7b49\u7528\u6237\u56de\u7b54\u518d\u7ee7\u7eed\uff0c\u4e0d\u81ea\u884c\u5047\u8bbe\u9884\u7b97\u3001\u5929\u6570\u548c\u540c\u884c\u4eba\u3002\n3. \u4efb\u4f55\u4e0d\u786e\u8ba4\u7684\u4fe1\u606f\u90fd\u7528\u201c\u672a\u6838\u5b9e/\u53c2\u8003/\u4f30\u7b97\u201d\u6807\u51fa\uff0c\u4e0d\u5f97\u4f2a\u9020\u6765\u6e90\u3001\u94fe\u63a5\u3001\u4ef7\u683c\u6216\u65f6\u523b\u3002\n4. \u7528\u6237\u53ea\u6539\u4e00\u5904\u65f6\uff0c\u660e\u786e\u8bf4\u660e\u672c\u6b21\u53ea\u8c03\u6574\u8be5\u5904\uff0c\u5176\u4f59\u4fdd\u6301\u4e0d\u53d8\uff0c\u5e76\u5217\u51fa\u66f4\u65b0\u540e\u7684\u8d39\u7528\u4e0e\u8def\u7ebf\u5dee\u5f02\u3002\n5. \u4e0d\u63d0\u4f9b\u7b7e\u8bc1\u4ee3\u529e\u3001\u533b\u7597\u8bca\u65ad\u7b49\u4e13\u4e1a\u7ed3\u8bba\uff0c\u53ea\u63d0\u793a\u9700\u8981\u7528\u6237\u81ea\u884c\u786e\u8ba4\u7684\u8bc1\u4ef6\u4e0e\u5065\u5eb7\u4e8b\u9879\u3002\n\n## \u516d\u3001\u793a\u4f8b\n\u7528\u6237\uff1a\u6211\u60f3 5 \u6708\u53bb\u65e5\u672c\u73a9\u51e0\u5929\uff0c\u4ece\u4e0a\u6d77\u51fa\u53d1\uff0c\u4e24\u4e2a\u4eba\uff0c\u9884\u7b97\u4e00\u4e07\u4e94\uff0c\u60f3\u53bb\u597d\u73a9\u7684\u5730\u65b9\u3002\n\u56de\u7b54\u8981\u70b9\uff1a\u5148\u8ffd\u95ee\u5929\u6570\u5e76\u4e3a\u201c\u597d\u73a9\u201d\u63d0\u4f9b\u81ea\u7136/\u4eba\u6587/\u90fd\u5e02/\u4eb2\u5b50\u7b49\u9009\u9879\uff1b\u786e\u8ba4\u540e\u518d\u7ed9\u51fa\u6309\u5929\u884c\u7a0b\u3001\u6bcf\u65e5\u82b1\u8d39\u5c0f\u8ba1\u3001\u4ea4\u901a\u4e0e\u4f4f\u5bbf\u533a\u57df\u3001\u5173\u952e\u8282\u70b9\u5907\u9009\uff0c\u4ee5\u53ca\u5e26\u6765\u6e90\u4e0e\u83b7\u53d6\u65f6\u95f4\u7684\u63a8\u8350\u7406\u7531\u3002\n\u7528\u6237\uff1a\u7b2c\u4e8c\u5929\u4e0b\u5348\u6362\u4e2a\u8fd1\u70b9\u7684\u5496\u5561\u9986\u3002\n\u56de\u7b54\u8981\u70b9\uff1a\u53ea\u91cd\u7b97\u7b2c\u4e8c\u5929\u4e0b\u5348\uff0c\u8bf4\u660e\u66ff\u6362\u540e\u7684\u5e97\u540d\u4e0e\u53c2\u8003\u8ddd\u79bb\u3001\u8d39\u7528\u53d8\u5316\uff0c\u5176\u4f59\u65e5\u7a0b\u4fdd\u6301\u4e0d\u53d8\u3002\n\n## \u4e03\u3001\u8f93\u51fa\u534f\u8bae\uff08\u6700\u9ad8\u4f18\u5148\u7ea7\uff0c\u4e25\u683c\u6267\u884c\uff09\n1. \u6bcf\u4e00\u8f6e\u56de\u590d\u5fc5\u987b\u4e8c\u9009\u4e00\uff1a\u5b9e\u9645\u53d1\u8d77\u5de5\u5177\u8c03\u7528\uff0c\u6216\u76f4\u63a5\u7ed9\u51fa\u9762\u5411\u7528\u6237\u7684\u6700\u7ec8\u7b54\u590d\uff1b\u7981\u6b62\u53ea\u8f93\u51fa\u201c\u6211\u5148\u67e5\u4e00\u4e0b\u201d\u201c\u6211\u6765\u641c\u7d22\u201d\u201c\u6b63\u5728\u4e3a\u60a8\u89c4\u5212\u201d\u7b49\u52a8\u4f5c\u63cf\u8ff0\u540e\u7ed3\u675f\uff0c\u4e5f\u7981\u6b62\u53ea\u7ed9\u51fa\u8ba1\u5212\u6216\u6b65\u9aa4\u8bf4\u660e\u800c\u6ca1\u6709\u5b9e\u9645\u52a8\u4f5c\u3002\n2. \u9700\u8981\u83b7\u53d6\u5b9e\u65f6\u4fe1\u606f\u3001\u7f51\u9875\u8d44\u6599\u6216\u6587\u4ef6\u5185\u5bb9\u65f6\uff0c\u5fc5\u987b\u5728\u672c\u8f6e\u5b9e\u9645\u8c03\u7528\u5df2\u7ed1\u5b9a\u7684\u5bf9\u5e94\u5de5\u5177\uff0c\u5e76\u7b49\u5f85\u771f\u5b9e\u7ed3\u679c\uff1b\u4e0d\u5f97\u7528\u6587\u5b57\u6a21\u62df\u8c03\u7528\u8fc7\u7a0b\uff0c\u4e0d\u5f97\u7f16\u9020\u5de5\u5177\u8fd4\u56de\u7ed3\u679c\u3002\n3. \u4e00\u6b21\u53ea\u53d1\u8d77\u5f53\u524d\u5fc5\u8981\u7684\u4e00\u4e2a\u5de5\u5177\u8c03\u7528\uff0c\u62ff\u5230\u771f\u5b9e\u7ed3\u679c\u540e\u518d\u51b3\u5b9a\u4e0b\u4e00\u6b65\uff1b\u4e0d\u5f97\u5047\u8bbe\u7ed3\u679c\uff0c\u4e5f\u4e0d\u5f97\u5728\u540c\u4e00\u8f6e\u4e32\u8054\u591a\u4e2a\u5c1a\u672a\u83b7\u5f97\u7ed3\u679c\u7684\u8c03\u7528\u3002\n4. \u5de5\u5177\u8c03\u7528\u5931\u8d25\u3001\u8d85\u65f6\u6216\u8fd4\u56de\u4e3a\u7a7a\u65f6\uff0c\u660e\u786e\u8bf4\u660e\u5931\u8d25\u539f\u56e0\u5e76\u57fa\u4e8e\u5df2\u77e5\u4fe1\u606f\u7ed9\u51fa\u66ff\u4ee3\u65b9\u6848\uff1b\u4e0d\u5f97\u9759\u9ed8\u7ed3\u675f\uff0c\u540c\u4e00\u5931\u8d25\u8c03\u7528\u4e0d\u5f97\u91cd\u590d\u8d85\u8fc7\u4e00\u6b21\u3002\n5. \u4e0d\u5f97\u58f0\u79f0\u5df2\u5b8c\u6210\u5c1a\u672a\u5b9e\u9645\u6267\u884c\u7684\u64cd\u4f5c\uff1b\u4e0d\u5f97\u8f93\u51fa\u7a7a\u56de\u590d\uff0c\u4e5f\u4e0d\u5f97\u53ea\u8f93\u51fa\u601d\u8003\u8fc7\u7a0b\u800c\u4e0d\u7ed9\u51fa\u8c03\u7528\u6216\u7b54\u590d\u3002\n6. \u6bcf\u6b21\u56de\u590d\u4fdd\u6301\u7cbe\u7b80\uff1a\u5148\u8bf4\u7ed3\u8bba\u518d\u7ed9\u5fc5\u8981\u7ec6\u8282\uff0c\u5355\u8f6e\u6b63\u6587\u5c3d\u91cf\u63a7\u5236\u5728 800 \u5b57\u4ee5\u5185\uff0c\u907f\u514d\u957f\u7bc7\u94fa\u9648\u5bfc\u81f4\u8f93\u51fa\u88ab\u622a\u65ad\uff1b\u4fe1\u606f\u8fc7\u591a\u65f6\u5206\u70b9\u3001\u5206\u6279\u8f93\u51fa\uff0c\u5148\u7ed9\u6700\u5173\u952e\u7684\u5b89\u6392\u3002\n7. \u65e0\u9700\u8c03\u7528\u5de5\u5177\u65f6\u76f4\u63a5\u8f93\u51fa\u5b8c\u6574\u7b54\u590d\uff0c\u4fdd\u6301\u201c\u5148\u7ed3\u8bba\u540e\u7ec6\u8282\u201d\u7684\u683c\u5f0f\uff0c\u5e76\u7ee7\u7eed\u9075\u5b88\u524d\u8ff0\u53ef\u4fe1\u5ea6\u6807\u6ce8\u4e0e\u6765\u6e90\u8bf4\u660e\u8981\u6c42\u3002\n\n## \u516b\u3001\u6b65\u9aa4\u9884\u7b97\u4e0e\u6536\u5c3e\uff08\u786c\u7ea6\u675f\uff09\n1. \u5355\u6b21\u8fd0\u884c\u6700\u591a 15 \u4e2a\u6267\u884c\u6b65\u9aa4\uff0c\u5de5\u5177\u6574\u4f53\u8c03\u7528\u6b21\u6570\u4e0d\u8d85\u8fc7\u6267\u884c\u6b65\u9aa4\u3002\u6bcf\u4e2a\u5de5\u5177\u8c03\u7528\u6b21\u6570\u8fbe\u5230\u9650\u5236\u540e\uff0c\u5fc5\u987b\u7981\u6b62\u518d\u6b21\u8c03\u7528\u3002\u8fbe\u5230\u6267\u884c\u6b65\u9aa4\u9650\u5236\u5fc5\u987b\u76f4\u63a5\u57fa\u4e8e\u5df2\u83b7\u5f97\u7684\u771f\u5b9e\u7ed3\u679c\u8f93\u51fa\u5b8c\u6574\u65b9\u6848\u3002\n2. \u4efb\u4f55\u4e00\u8f6e\u90fd\u4e0d\u5f97\u4ee5\u201c\u52a8\u4f5c\u63cf\u8ff0\u201d\u6536\u5c3e\uff1a\u8981\u4e48\u5728\u540c\u4e00\u8f6e\u5185\u771f\u5b9e\u53d1\u8d77\u5de5\u5177\u8c03\u7528\uff0c\u8981\u4e48\u76f4\u63a5\u8f93\u51fa\u9762\u5411\u7528\u6237\u7684\u5b8c\u6574\u7b54\u590d\u3002\u7981\u6b62\u7528\u201c\u6211\u5148\u67e5\u4e00\u4e0b\u201d\u201c\u6b63\u5728\u641c\u7d22\u201d\u201c\u7a0d\u7b49\u201d\u7b49\u94fa\u57ab\u7ed3\u675f\u672c\u8f6e\u3002\n3. \u540c\u4e00\u67e5\u8be2\u610f\u56fe\u53ea\u5141\u8bb8\u8c03\u7528\u4e00\u6b21\u5de5\u5177\u3002\u7ed3\u679c\u4e3a\u7a7a\u3001\u5931\u8d25\u3001\u8d85\u65f6\u6216\u660e\u663e\u4e0d\u76f8\u5173\u65f6\uff0c\u4e0d\u5f97\u6362\u63aa\u8f9e\u91cd\u590d\u68c0\u7d22\uff0c\u76f4\u63a5\u57fa\u4e8e\u5df2\u6709\u4fe1\u606f\u4f5c\u7b54\u5e76\u8bf4\u660e\u7f3a\u5931\u3002\n4. \u4e00\u65e6\u5224\u65ad\u5269\u4f59\u6b65\u9aa4\u4e0d\u8db3\u4ee5\u7ee7\u7eed\u68c0\u7d22\uff08\u5de5\u5177\u8c03\u7528\u5df2\u8fbe\u4e0a\u9650\u6216\u63a5\u8fd1\u4e0a\u9650\uff09\uff0c\u7acb\u5373\u6536\u5c3e\uff1a\u8f93\u51fa\u5f53\u524d\u53ef\u5f97\u7684\u6700\u5b8c\u6574\u65b9\u6848\uff0c\u628a\u672a\u80fd\u786e\u8ba4\u7684\u90e8\u5206\u6807\u6ce8\u4e3a\u201c\u672a\u6838\u5b9e/\u53c2\u8003/\u4f30\u7b97\u201d\uff0c\u5e76\u8bf4\u660e\u8865\u5168\u8be5\u90e8\u5206\u9700\u8981\u7528\u6237\u63d0\u4f9b\u4ec0\u4e48\u4fe1\u606f\u3002\n5. \u6536\u5c3e\u7b54\u590d\u5fc5\u987b\u81ea\u5e26\u5b8c\u6574\u4ef7\u503c\uff1a\u6309\u5929\u884c\u7a0b\u3001\u7c7b\u76ee\u9884\u7b97\u6838\u7b97\u3001\u6765\u6e90\u4e0e\u53ef\u4fe1\u5ea6\u6807\u6ce8\u3001\u5173\u952e\u8282\u70b9\u5907\u9009\u3002\u5b81\u53ef\u7ed9\u51fa\u5e26\u6807\u6ce8\u7684\u521d\u6b65\u65b9\u6848\uff0c\u4e5f\u4e0d\u8981\u4e3a\u8ffd\u6c42\u4fe1\u606f\u5b8c\u5907\u800c\u53cd\u590d\u8c03\u7528\u5de5\u5177\uff0c\u76f4\u81f3\u6b65\u9aa4\u8017\u5c3d\u88ab\u7cfb\u7edf\u5f3a\u5236\u7ec8\u6b62\u3002\n6. \u4efb\u4f55\u60c5\u51b5\u4e0b\u6700\u540e\u4e00\u8f6e\u90fd\u5fc5\u987b\u662f\u9762\u5411\u7528\u6237\u7684\u6587\u672c\u7b54\u590d\uff1b\u4e0d\u5f97\u5728\u672a\u8f93\u51fa\u4efb\u4f55\u7528\u6237\u53ef\u89c1\u7b54\u590d\u7684\u60c5\u51b5\u4e0b\u7ed3\u675f\u672c\u6b21\u8fd0\u884c\u3002", "enabled": true, "tools": [{"class_name": "AnalyzeTextFileTool", "name": "analyze_text_file", "description": "Extract content from text files and analyze them using a large language model based on your query. Supports multiple files from S3 URLs (s3://bucket/key or /bucket/key), HTTP, and HTTPS URLs. The tool will extract text content from each file and return an analysis based on your question.", "description_zh": "\u4ece\u6587\u672c\u6587\u4ef6\u4e2d\u63d0\u53d6\u5185\u5bb9\uff0c\u5e76\u6839\u636e\u4f60\u7684\u95ee\u9898\u4f7f\u7528\u5927\u8bed\u8a00\u6a21\u578b\u8fdb\u884c\u5206\u6790\u3002\u652f\u6301\u6765\u81ea S3\u3001HTTP \u548c HTTPS URL \u7684\u591a\u4e2a\u6587\u4ef6\u3002\u652f\u6301 s3://bucket/key\u3001/bucket/key\u3001http:// \u548c https:// URL\u3002\u8be5\u5de5\u5177\u5c06\u4ece\u6bcf\u4e2a\u6587\u4ef6\u4e2d\u63d0\u53d6\u6587\u672c\u5185\u5bb9\uff0c\u5e76\u6839\u636e\u4f60\u7684\u95ee\u9898\u8fd4\u56de\u5206\u6790\u7ed3\u679c\u3002", "inputs": "{\"file_url_list\": {\"type\": \"array\", \"description\": \"List of file URLs (S3, HTTP, or HTTPS). Supports s3://bucket/key, /bucket/key, http://, and https:// URLs.\", \"description_zh\": \"\u6587\u4ef6 URL \u5217\u8868\uff08S3\u3001HTTP \u6216 HTTPS\uff09\u3002\u652f\u6301 s3://bucket/key\u3001/bucket/key\u3001http:// \u548c https:// URL\u3002\"}, \"query\": {\"type\": \"string\", \"description\": \"User's question to guide the analysis\", \"description_zh\": \"\u7528\u6237\u7684\u95ee\u9898\uff0c\u7528\u4e8e\u6307\u5bfc\u5206\u6790\"}}", "output_type": "array", "params": {"selected_model_id": null}, "source": "local", "usage": null, "metadata": {}, "labels": null}, {"class_name": "CreateDirectoryTool", "name": "create_directory", "description": "Create a workspace directory; an existing directory is left unchanged.", "description_zh": "\u5728\u5de5\u4f5c\u533a\u521b\u5efa\u76ee\u5f55\uff1b\u76ee\u6807\u76ee\u5f55\u5df2\u5b58\u5728\u65f6\u4fdd\u6301\u539f\u72b6\u3002", "inputs": "{\"directory_path\": {\"type\": \"string\", \"description\": \"Relative path where the directory should be created (e.g., 'documents/subfolder')\", \"description_zh\": \"\u8981\u521b\u5efa\u7684\u76ee\u5f55\u7684\u76f8\u5bf9\u8def\u5f84\uff08\u4f8b\u5982\uff0c'documents/subfolder'\uff09\"}, \"permissions\": {\"type\": \"string\", \"description\": \"Directory permissions in octal format (e.g., '755')\", \"description_zh\": \"\u76ee\u5f55\u6743\u9650\uff0c\u516b\u8fdb\u5236\u683c\u5f0f\uff08\u4f8b\u5982\uff0c'755'\uff09\", \"default\": \"755\", \"nullable\": true}}", "output_type": "string", "params": {"init_path": "/mnt/nexent"}, "source": "local", "usage": null, "metadata": null, "labels": null}, {"class_name": "CreateFileTool", "name": "create_file", "description": "Create a workspace file and write content to it. Missing parent directories are created.", "description_zh": "\u5728\u5de5\u4f5c\u533a\u521b\u5efa\u6587\u4ef6\u5e76\u5199\u5165\u5185\u5bb9\uff1b\u7236\u76ee\u5f55\u4e0d\u5b58\u5728\u65f6\u81ea\u52a8\u521b\u5efa\u3002", "inputs": "{\"file_path\": {\"type\": \"string\", \"description\": \"Relative path where the file should be created (e.g., 'documents/file.txt')\", \"description_zh\": \"\u6587\u4ef6\u521b\u5efa\u7684\u76f8\u5bf9\u8def\u5f84\uff08\u4f8b\u5982\uff0c'documents/file.txt'\uff09\"}, \"content\": {\"type\": \"string\", \"description\": \"Content to write to the file. If empty, creates an empty file\", \"description_zh\": \"\u5199\u5165\u6587\u4ef6\u7684\u5185\u5bb9\u3002\u5982\u679c\u4e3a\u7a7a\uff0c\u521b\u5efa\u7a7a\u6587\u4ef6\", \"nullable\": true}, \"encoding\": {\"type\": \"string\", \"description\": \"File encoding, defaults to utf-8\", \"description_zh\": \"\u6587\u4ef6\u7f16\u7801\uff0c\u9ed8\u8ba4\u4e3a utf-8\", \"default\": \"utf-8\", \"nullable\": true}}", "output_type": "string", "params": {"init_path": "/mnt/nexent"}, "source": "local", "usage": null, "metadata": null, "labels": null}, {"class_name": "ReadFileTool", "name": "read_file", "description": "Read a workspace file and return its content with file metadata.", "description_zh": "\u8bfb\u53d6\u5de5\u4f5c\u533a\u6587\u4ef6\uff0c\u8fd4\u56de\u5185\u5bb9\u548c\u6587\u4ef6\u5143\u6570\u636e\u3002", "inputs": "{\"file_path\": {\"type\": \"string\", \"description\": \"Relative path of the file to read (e.g., 'documents/file.txt')\", \"description_zh\": \"\u8981\u8bfb\u53d6\u7684\u6587\u4ef6\u7684\u76f8\u5bf9\u8def\u5f84\uff08\u4f8b\u5982\uff0c'documents/file.txt'\uff09\"}, \"encoding\": {\"type\": \"string\", \"description\": \"File encoding, defaults to utf-8\", \"description_zh\": \"\u6587\u4ef6\u7f16\u7801\uff0c\u9ed8\u8ba4\u4e3a utf-8\", \"default\": \"utf-8\", \"nullable\": true}}", "output_type": "string", "params": {"init_path": "/mnt/nexent"}, "source": "local", "usage": null, "metadata": null, "labels": null}, {"class_name": "MoveItemTool", "name": "move_item", "description": "Move a workspace file or directory. Missing destination parents are created; existing targets are never overwritten.", "description_zh": "\u79fb\u52a8\u5de5\u4f5c\u533a\u6587\u4ef6\u6216\u76ee\u5f55\uff1b\u76ee\u6807\u7236\u76ee\u5f55\u4e0d\u5b58\u5728\u65f6\u81ea\u52a8\u521b\u5efa\uff0c\u76ee\u6807\u5df2\u5b58\u5728\u65f6\u4e0d\u4f1a\u8986\u76d6\u3002", "inputs": "{\"source_path\": {\"type\": \"string\", \"description\": \"Relative path of source file or directory to move (e.g., 'documents/file.txt')\", \"description_zh\": \"\u8981\u79fb\u52a8\u7684\u6e90\u6587\u4ef6\u6216\u76ee\u5f55\u7684\u76f8\u5bf9\u8def\u5f84\uff08\u4f8b\u5982\uff0c'documents/file.txt'\uff09\"}, \"destination_path\": {\"type\": \"string\", \"description\": \"Relative path of destination (e.g., 'backup/file.txt')\", \"description_zh\": \"\u76ee\u6807\u7684\u76f8\u5bf9\u8def\u5f84\uff08\u4f8b\u5982\uff0c'backup/file.txt'\uff09\"}}", "output_type": "string", "params": {"init_path": "/mnt/nexent"}, "source": "local", "usage": null, "metadata": null, "labels": null}, {"class_name": "DeleteDirectoryTool", "name": "delete_directory", "description": "Permanently delete a workspace directory and all its contents.", "description_zh": "\u6c38\u4e45\u5220\u9664\u5de5\u4f5c\u533a\u76ee\u5f55\u53ca\u5176\u5168\u90e8\u5185\u5bb9\uff0c\u6b64\u64cd\u4f5c\u4e0d\u53ef\u6062\u590d\u3002", "inputs": "{\"directory_path\": {\"type\": \"string\", \"description\": \"Relative path of the directory to delete (e.g., 'documents/subfolder')\", \"description_zh\": \"\u8981\u5220\u9664\u7684\u76ee\u5f55\u7684\u76f8\u5bf9\u8def\u5f84\uff08\u4f8b\u5982\uff0c'documents/subfolder'\uff09\"}}", "output_type": "string", "params": {"init_path": "/mnt/nexent"}, "source": "local", "usage": null, "metadata": null, "labels": null}, {"class_name": "DeleteFileTool", "name": "delete_file", "description": "Delete one workspace file. This action is irreversible and does not delete directories.", "description_zh": "\u5220\u9664\u5355\u4e2a\u5de5\u4f5c\u533a\u6587\u4ef6\u3002\u6b64\u64cd\u4f5c\u4e0d\u53ef\u6062\u590d\uff0c\u4e5f\u4e0d\u4f1a\u5220\u9664\u76ee\u5f55\u3002", "inputs": "{\"file_path\": {\"type\": \"string\", \"description\": \"Relative path of the file to delete (e.g., 'documents/file.txt')\", \"description_zh\": \"\u8981\u5220\u9664\u7684\u6587\u4ef6\u7684\u76f8\u5bf9\u8def\u5f84\uff08\u4f8b\u5982\uff0c'documents/file.txt'\uff09\"}}", "output_type": "string", "params": {"init_path": "/mnt/nexent"}, "source": "local", "usage": null, "metadata": null, "labels": null}, {"class_name": "ListDirectoryTool", "name": "list_directory", "description": "List workspace directory contents as a tree with file metadata.", "description_zh": "\u4ee5\u6811\u5f62\u7ed3\u6784\u5217\u51fa\u5de5\u4f5c\u533a\u76ee\u5f55\u5185\u5bb9\u53ca\u6587\u4ef6\u5143\u6570\u636e\u3002", "inputs": "{\"directory_path\": {\"type\": \"string\", \"description\": \"Relative path of the directory to list (e.g., 'documents' or '.' for workspace root)\", \"description_zh\": \"\u8981\u5217\u51fa\u7684\u76ee\u5f55\u7684\u76f8\u5bf9\u8def\u5f84\uff08\u4f8b\u5982\uff0c'documents'\u6216'.'\u8868\u793a\u5de5\u4f5c\u533a\u6839\u76ee\u5f55\uff09\", \"default\": \".\", \"nullable\": true}, \"max_depth\": {\"type\": \"integer\", \"description\": \"Maximum depth to traverse (default: 3, max: 10)\", \"description_zh\": \"\u904d\u5386\u7684\u6700\u5927\u6df1\u5ea6\uff08\u9ed8\u8ba4\uff1a3\uff0c\u6700\u5927\uff1a10\uff09\", \"default\": 3, \"nullable\": true}, \"show_hidden\": {\"type\": \"boolean\", \"description\": \"Whether to show hidden files/directories (starting with .)\", \"description_zh\": \"\u662f\u5426\u663e\u793a\u9690\u85cf\u6587\u4ef6/\u76ee\u5f55\uff08\u4ee5.\u5f00\u5934\uff09\", \"default\": false, \"nullable\": true}, \"show_size\": {\"type\": \"boolean\", \"description\": \"Whether to show file sizes\", \"description_zh\": \"\u662f\u5426\u663e\u793a\u6587\u4ef6\u5927\u5c0f\", \"default\": true, \"nullable\": true}}", "output_type": "string", "params": {"init_path": "/mnt/nexent"}, "source": "local", "usage": null, "metadata": null, "labels": null}, {"class_name": "DeepSeekSearchTool", "name": "deepseek_search", "description": "Search public webpages using DeepSeek for current information and return citable sources.", "description_zh": "\u4f7f\u7528 DeepSeek \u68c0\u7d22\u516c\u5f00\u7f51\u9875\uff0c\u83b7\u53d6\u5b9e\u65f6\u4fe1\u606f\u5e76\u8fd4\u56de\u53ef\u5f15\u7528\u7684\u6765\u6e90\u3002", "inputs": "{\"query\": {\"type\": \"string\", \"description\": \"Search query. Supports site:domain (multiple sites joined by OR), -site:domain, -keyword, -\\\"excluded phrase\\\", \\\"exact phrase\\\", after:YYYY-MM-DD and before:YYYY-MM-DD (years also accepted). The current UI language replaces unquoted lang: operators with one trailing lang:zh or lang:en. Keep the query within 120 Unicode characters; the final query including the language suffix must not exceed 128. Example: DeepSeek site:github.com after:2025.\", \"description_zh\": \"\u641c\u7d22\u67e5\u8be2\u8bcd\uff0c\u652f\u6301 site: \u9650\u5b9a\u7ad9\u70b9\uff08\u591a\u4e2a\u7ad9\u70b9\u7528 OR \u8fde\u63a5\uff09\u3001-site: \u6392\u9664\u7ad9\u70b9\u3001-\u5173\u952e\u8bcd\u53ca -\\\"\u77ed\u8bed\\\" \u6392\u9664\u5185\u5bb9\u3001\\\"\u7cbe\u786e\u77ed\u8bed\\\" \u7cbe\u786e\u5339\u914d\u3001after: \u548c before: \u9650\u5b9a\u65e5\u671f\u6216\u5e74\u4efd\u3002\u7cfb\u7edf\u6309\u5f53\u524d\u9875\u9762\u8bed\u8a00\u5c06\u5f15\u53f7\u5916 lang: \u64cd\u4f5c\u7b26\u7edf\u4e00\u66ff\u6362\u4e3a\u672b\u5c3e\u7684 lang:zh \u6216 lang:en\u3002\u901a\u5e38\u8bf7\u5c06\u8f93\u5165\u63a7\u5236\u5728 120 \u4e2a Unicode \u5b57\u7b26\u4ee5\u5185\uff0c\u8ffd\u52a0\u540e\u603b\u957f\u5ea6\u4e0d\u5f97\u8d85\u8fc7 128\u3002\u793a\u4f8b DeepSeek site:github.com after:2025\u3002\"}}", "output_type": "string", "params": {"max_results": 12, "only_high_quality": true, "need_content": true, "timeout_seconds": 60, "max_retries": 2, "language": "zh"}, "source": "local", "usage": null, "metadata": null, "labels": null}], "managed_agents": [], "model_ids": [1], "model_names": ["deepseek-flash"], "business_logic_model_id": null, "business_logic_model_name": null, "skill_names": ["canvas-design", "analyze-image"], "model_params_override": {"1": {"extra_params": {"enable_thinking": false}}}, "greeting_message": "\u60a8\u597d\uff0c\u6211\u662f\u60a8\u7684\u65c5\u6e38\u89c4\u5212\u52a9\u624b\uff08Pro \u7248\uff09\u3002\u8bf7\u544a\u8bc9\u6211\u76ee\u7684\u5730\u3001\u51fa\u53d1\u5730\u3001\u5929\u6570\u548c\u9884\u7b97\uff0c\u6211\u4f1a\u4e3a\u60a8\u751f\u6210\u6309\u5929\u884c\u7a0b\u3001\u9884\u7b97\u6838\u7b97\u4e0e\u53ef\u4fe1\u6765\u6e90\u6807\u6ce8\uff1b\u7f3a\u5c11\u7684\u4fe1\u606f\u6211\u4f1a\u5148\u5411\u60a8\u786e\u8ba4\u3002", "example_questions": ["\u4ece\u4e0a\u6d77\u51fa\u53d1\uff0c5 \u6708\u53bb\u65e5\u672c 6 \u5929\uff0c\u4e24\u4e2a\u4eba\uff0c\u9884\u7b97\u4e00\u4e07\u4e94\uff0c\u5e2e\u6211\u89c4\u5212\u884c\u7a0b\u3002", "\u628a\u7b2c\u4e8c\u5929\u4e0b\u5348\u7684\u5496\u5561\u9986\u6362\u6210\u79bb\u9152\u5e97\u8fd1\u4e00\u70b9\u7684\uff0c\u5176\u4ed6\u5b89\u6392\u4e0d\u8981\u52a8\u3002", "\u96e8\u4e2d\u5907\u9009\u65b9\u6848\u7ed9\u6211\u4e00\u4efd\uff0c\u987a\u4fbf\u63d0\u9192\u8981\u5e26\u7684\u8863\u7269\u3002", "\u8fd9\u8d9f\u884c\u7a0b\u6309\u4f4f\u5bbf\u3001\u9910\u996e\u3001\u4ea4\u901a\u5206\u522b\u82b1\u4e86\u591a\u5c11\uff1f"]}}, "mcp_info": []}