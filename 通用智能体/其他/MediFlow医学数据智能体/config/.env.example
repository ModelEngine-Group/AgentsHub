# MediFlow 运行环境模板
# 复制为 mcps/mediflow-mcp/.env.runtime 后填写目标环境值。

# 模型服务
CCF_LLM_API_KEY=
CCF_LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
CCF_LLM_MODEL=deepseek-chat

# Nexent
CCF_NEXENT_EMAIL=admin@example.com
CCF_NEXENT_PASSWORD=
CCF_NEXENT_CONFIG_BASE=http://127.0.0.1:5010
CCF_NEXENT_RUNTIME_BASE=http://127.0.0.1:5014
CCF_NEXENT_FRONTEND_URL=https://nexent.example.com/

# MCP
MCP_HOST=0.0.0.0
MCP_PORT=8900
CCF_MCP_URL=http://127.0.0.1:8900/mcp
CCF_MCP_PUBLIC_URL=https://mcp.example.com/mcp
CCF_MCP_SERVICE_NAME=medical-ai

# DataMate
CCF_DATAMATE_BASE=http://127.0.0.1:18000
CCF_DATAMATE_GATEWAY=http://127.0.0.1:8080
CCF_DATAMATE_FRONTEND_URL=https://datamate.example.com/
CCF_DATASET_VOLUME=/path/to/datamate-dataset-volume
CCF_DATAMATE_OPERATOR_VOLUME=/path/to/datamate-operator-runtime-volume
CCF_DATAMATE_RUNTIME_CONTAINER=datamate-runtime

# 可选的分析结果展示入口。MCP 只读取该地址，不在本归档包内启动前端。
CCF_ANALYTICS_FRONTEND_URL=https://analytics.example.com/
CCF_PUBLIC_DOMAIN=example.com

# 输入数据和运行数据库
CCF_DATA_ROOT=data/input
CCF_MEDICAL_KG_DATA=
CCF_MEDICAL_KG_DB=data/task2_medical_kg.db
CCF_ANALYTICS_DB=data/task3_analytics.db
CCF_TASK2_KG_DB=data/task2_medical_kg.db
CCF_TASK3_ANALYTICS_DB=data/task3_analytics.db

# 数据处理与抽取参数
CCF_TASK2_BACKEND=hybrid
CCF_TASK2_CASCADE_MAX_GAP_SEGMENTS=12
CCF_TASK2_CASCADE_MAX_GAP_SEGMENTS_TOTAL=96
CCF_TASK2_CASCADE_GAP_WORKERS=8
CCF_TASK2_CASCADE_GAP_BATCH_SIZE=6
CCF_TASK2_CASCADE_MAX_REVIEW_CANDIDATES=256
CCF_TASK2_LLM_GAP_AUTO_ACCEPT_CONFIDENCE=0.90

# PDF 解析服务
CCF_MINERU_API=https://mineru.net/api/v1/agent
CCF_MINERU_TIMEOUT_SECONDS=300
CCF_MINERU_POLL_INTERVAL_SECONDS=2
CCF_MINERU_REQUEST_TIMEOUT_SECONDS=30

# 可选：从文件读取模型密钥；读取 DataMate 数据卷时可能需要 sudo 密码
CCF_LLM_API_KEY_FILE=/run/secrets/ccf_llm_api_key
CCF_SUDO_PW=
